---
import { nav, site } from '../site.config';
import { href, isActive } from '../lib/href';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="wordmark" href={href('/')}>{site.wordmark}</a>

    <nav class="site-nav" aria-label="Navegação principal">
      {
        nav.map((item) => (
          <a
            href={href(item.href)}
            class="site-nav__link"
            aria-current={isActive(pathname, item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(10px) saturate(1.4);
    -webkit-backdrop-filter: blur(10px) saturate(1.4);
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition);
  }

  /* hairline appears once the page is scrolled (see script) */
  .site-header[data-scrolled] {
    border-bottom-color: var(--line);
  }

  .site-header__inner {
    max-width: var(--wide-width);
    margin-inline: auto;
    min-height: var(--header-h);
    padding-inline: var(--space-m);
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }

  .wordmark {
    font-size: var(--step-0);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
    margin-right: auto;
    white-space: nowrap;
  }

  .wordmark:hover {
    color: var(--ink);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2.5vw, 1.9rem);
  }

  .site-nav__link {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--ink-soft);
    text-decoration: none;
    padding-block: 0.4rem;
    position: relative;
  }

  .site-nav__link:hover {
    color: var(--ink);
  }

  .site-nav__link[aria-current='page'] {
    color: var(--ink);
  }

  .site-nav__link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.1rem;
    height: 1.5px;
    background: var(--accent);
    border-radius: 2px;
  }

  @media (max-width: 30rem) {
    .site-header__inner {
      gap: var(--space-s);
      padding-inline: var(--space-s);
    }
    .wordmark {
      font-size: var(--step--1);
    }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  if (header) {
    const onScroll = () => {
      if (window.scrollY > 4) header.setAttribute('data-scrolled', '');
      else header.removeAttribute('data-scrolled');
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
