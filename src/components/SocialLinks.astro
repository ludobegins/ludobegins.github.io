---
import { socials } from '../site.config';
import Icon from './Icon.astro';

interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: className } = Astro.props;
---

<ul class={`social ${className ?? ''}`}>
  {
    socials.map((s) => (
      <li>
        <a href={s.href} target="_blank" rel="me noopener noreferrer" aria-label={s.label}>
          <Icon name={s.icon} size={size} />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    list-style: none;
    padding: 0;
  }

  .social a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    color: var(--ink-faint);
    transition:
      color var(--transition),
      background-color var(--transition),
      transform var(--transition);
  }

  .social a:hover {
    color: var(--ink);
    background: var(--accent-soft);
    transform: translateY(-2px);
  }
</style>
