---
import EscritoCard from './EscritoCard.astro';
import { type Locale } from '../i18n/ui';
import type { Escrito } from '../lib/escritos';

interface Props {
  escritos: Escrito[];
  locale: Locale;
  empty?: string;
}
const { escritos, locale, empty = '—' } = Astro.props;
---

{
  escritos.length > 0 ? (
    <div class="escrito-list">
      {escritos.map((entry) => (
        <EscritoCard entry={entry} locale={locale} />
      ))}
    </div>
  ) : (
    <p class="escrito-list__empty">{empty}</p>
  )
}

<style>
  .escrito-list {
    border-bottom: 1px solid var(--line);
  }

  .escrito-list__empty {
    color: var(--ink-soft);
    padding-block: var(--space-m);
  }
</style>
