---
import { href } from '../lib/href';
import {
  tipoLabel,
  formatMonthYear,
  getSlug,
  displayTitle,
  firstLine,
  type Escrito,
} from '../lib/escritos';

interface Props {
  entry: Escrito;
}
const { entry } = Astro.props;
const title = displayTitle(entry);
const hasTitle = Boolean(entry.data.title?.trim());
const sub = hasTitle ? firstLine(entry) : null;
---

<a class="card" href={href(`/escritos/${getSlug(entry)}`)}>
  <span class="card__title">{title}</span>
  {sub && <span class="card__sub">{sub}</span>}
  <span class="card__meta">
    {tipoLabel[entry.data.tipo]}
    <span aria-hidden="true">·</span>
    {formatMonthYear(entry.data.date)}
  </span>
</a>

<style>
  .card {
    display: grid;
    gap: var(--space-3xs);
    padding: var(--space-m) 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
    transition: border-color var(--transition);
  }

  .card:hover {
    border-top-color: var(--accent);
  }

  .card__title {
    font-size: var(--step-1);
    color: var(--ink);
    line-height: var(--leading-snug);
  }

  .card:hover .card__title {
    color: var(--accent-ink);
  }

  .card__sub {
    color: var(--ink-soft);
    font-size: var(--step-0);
  }

  .card__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--ink-faint);
  }
</style>
