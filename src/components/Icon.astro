---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  role="img"
  aria-hidden="true"
  focusable="false"
  fill={icon.fill ? 'currentColor' : 'none'}
  set:html={icon.body}
/>
