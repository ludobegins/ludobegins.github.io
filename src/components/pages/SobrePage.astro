---
import Base from '../../layouts/Base.astro';
import SocialLinks from '../SocialLinks.astro';
import { type Locale } from '../../i18n/ui';
import { t } from '../../i18n/utils';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const s = t(locale).sobre;
---

<Base title={s.title} description={s.metaDescription}>
  <article class="page wrap wrap--prose flow">
    <header class="page__head">
      <p class="eyebrow">{s.eyebrow}</p>
      <h1>Ludovic Beghin</h1>
    </header>

    <div class="bio flow">
      {s.bio.map((p) => <p>{p}</p>)}
    </div>

    <section class="section flow">
      <h2>{s.projectsTitle}</h2>
      <ul class="projects">
        {
          s.projects.map((p) => (
            <li>
              <a href={p.href} target="_blank" rel="noopener noreferrer">
                {p.name}
              </a>
              <span> — {p.text}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section flow">
      <h2>{s.contactTitle}</h2>
      <p set:html={s.contactHtml} />
      <SocialLinks size={20} />
    </section>
  </article>
</Base>

<style>
  .page {
    padding-top: var(--space-xl);
    --flow-space: var(--space-l);
  }

  .page__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .bio {
    --flow-space: var(--space-m);
    font-size: var(--step-0);
  }

  .section {
    --flow-space: var(--space-s);
  }

  .section h2 {
    font-size: var(--step-1);
    color: var(--ink);
  }

  .projects {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-s);
  }

  .projects li {
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
  }

  .projects span {
    color: var(--ink-soft);
  }
</style>
