---
import Base from '../layouts/Base.astro';
import LangSwitch from '../components/LangSwitch.astro';
import SocialLinks from '../components/SocialLinks.astro';

const projects = [
  {
    name: 'por-ai',
    text: 'Interactive 3D map of a bicycle crossing of Brazil, with waypoints and notes from the road.',
    href: 'https://github.com/ludobegins/por-ai',
  },
  {
    name: 'This site',
    text: 'Built with Astro, no backend. Open source on GitHub.',
    href: 'https://github.com/ludobegins/ludoblog',
  },
];
---

<Base
  title="About"
  description="Ludovic Beghin — software engineer looking for the next challenge."
  lang="en"
>
  <article class="page wrap wrap--prose flow">
    <header class="page__head flow">
      <div class="page__topline">
        <p class="eyebrow">About</p>
        <LangSwitch current="en" pt="/sobre" en="/about" />
      </div>
      <h1>Ludovic Beghin</h1>
    </header>

    <div class="bio flow">
      <p>
        Engineer by training, problem-solver at heart. I love finding elegant solutions to complex
        problems, from hunting down bugs to architecting scalable systems with Python, Angular, and
        AWS. I think my greatest asset is being able to adapt and learn quickly.
      </p>
      <p>
        After a recent 8-month bicycle expedition, I'm back at the keyboard and looking for my next
        challenge — ideally building software that makes a tangible environmental or social impact.
      </p>
      <p>
        When I'm off-screen: cycling remote roads, playing footvolley, reading, annoying my
        neighbours with my harmonica, or sharing a beer with friends.
      </p>
    </div>

    <section class="section flow">
      <h2>Projects</h2>
      <ul class="projects">
        {
          projects.map((p) => (
            <li>
              <a href={p.href} target="_blank" rel="noopener noreferrer">
                {p.name}
              </a>
              <span> — {p.text}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section flow">
      <h2>Contact</h2>
      <p>
        The best way to reach me is on
        <a
          href="https://www.linkedin.com/in/ludovic-beghin"
          target="_blank"
          rel="noopener noreferrer">LinkedIn</a
        >.
      </p>
      <SocialLinks size={20} />
    </section>
  </article>
</Base>

<style>
  .page {
    padding-top: var(--space-xl);
    --flow-space: var(--space-l);
  }
  .page__head {
    --flow-space: var(--space-s);
  }
  .page__topline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
  }
  .bio {
    --flow-space: var(--space-m);
    font-size: var(--step-0);
  }
  .section {
    --flow-space: var(--space-s);
  }
  .section h2 {
    font-size: var(--step-1);
    color: var(--ink);
  }
  .projects {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-s);
  }
  .projects li {
    padding-top: var(--space-s);
    border-top: 1px solid var(--line);
  }
  .projects span {
    color: var(--ink-soft);
  }
</style>
