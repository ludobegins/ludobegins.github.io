---
import Base from '../../layouts/Base.astro';
import EscritoList from '../../components/EscritoList.astro';
import TipoFilter from '../../components/TipoFilter.astro';
import { getEscritos } from '../../lib/escritos';

const escritos = await getEscritos();
---

<Base title="Escritos" description="Poemas e pensamentos de Ludovic Beghin.">
  <section class="page wrap wrap--prose">
    <header class="page__head flow">
      <p class="eyebrow">Escritos</p>
      <h1>Poemas &amp; pensamentos</h1>
      <p class="lead">
        A maior parte é poesia — muita dela escrita na estrada. O resto são pensamentos soltos.
      </p>
      <TipoFilter />
    </header>

    <EscritoList escritos={escritos} empty="Ainda não publiquei nada aqui." />
  </section>
</Base>

<style>
  .page {
    padding-top: var(--space-xl);
  }

  .page__head {
    --flow-space: var(--space-s);
    margin-bottom: var(--space-l);
  }

  .lead {
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: var(--leading-snug);
    max-width: 42ch;
  }
</style>
