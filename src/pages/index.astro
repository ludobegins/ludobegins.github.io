---
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Icon from '../components/Icon.astro';
import { href } from '../lib/href';

const doors = [
  {
    href: '/sobre',
    label: 'Sobre',
    text: 'Quem sou, o que faço e o tipo de trabalho que procuro.',
  },
  {
    href: '/escritos',
    label: 'Escritos',
    text: 'Poesia em primeiro lugar, com espaço para crônica e ensaio. Filtrável por tipo.',
  },
  {
    href: '/viagem',
    label: 'Viagem',
    text: 'Um mapa em 3D dos oito meses que passei atravessando o Brasil de bicicleta.',
  },
];
---

<Base
  title={undefined}
  description="Site pessoal de Ludovic Beghin — engenheiro de software, poemas e uma viagem de bicicleta."
>
  <section class="hero wrap wrap--wide">
    <img
      class="hero__avatar"
      src={href('/ludo.jpg')}
      alt="Retrato de Ludovic Beghin"
      width="120"
      height="120"
    />
    <div class="hero__body flow">
      <p class="eyebrow">Site pessoal &amp; caderno</p>
      <h1>Ludovic Beghin</h1>
      <p class="hero__line">
        Engenheiro de software. Escrevo poemas — e, de vez em quando, prosa. Em 2025 saí de Natal e
        fui de bicicleta até a Venezuela.
      </p>
      <SocialLinks />
    </div>
  </section>

  <nav class="doors wrap wrap--wide" aria-label="Seções do site">
    {
      doors.map((d) => (
        <a class="door" href={href(d.href)}>
          <span class="door__label">
            {d.label}
            <Icon name="arrow-right" size={18} class="door__arrow" />
          </span>
          <span class="door__text">{d.text}</span>
        </a>
      ))
    }
  </nav>
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    padding-top: var(--space-xl);
    padding-bottom: var(--space-l);
  }

  .hero__avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: var(--shadow);
  }

  .hero__body {
    --flow-space: var(--space-s);
    max-width: 34rem;
  }

  .hero__line {
    font-size: var(--step-1);
    color: var(--ink-soft);
    line-height: var(--leading-snug);
  }

  .doors {
    display: grid;
    gap: var(--space-s);
    padding-bottom: var(--space-xl);
  }

  .door {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding: var(--space-m) 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
    transition: border-color var(--transition);
  }

  .doors .door:last-child {
    border-bottom: 1px solid var(--line);
  }

  .door:hover {
    border-top-color: var(--accent);
  }

  .door__label {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--step-2);
    color: var(--ink);
  }

  .door__label :global(.door__arrow) {
    color: var(--ink-faint);
    transform: translateX(-4px);
    opacity: 0;
    transition:
      transform var(--transition),
      opacity var(--transition),
      color var(--transition);
  }

  .door:hover :global(.door__arrow) {
    transform: translateX(0);
    opacity: 1;
    color: var(--accent);
  }

  @media (hover: none) {
    .door__label :global(.door__arrow) {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .door__text {
    font-family: var(--font-ui);
    font-size: var(--step--1);
    color: var(--ink-soft);
    max-width: 46ch;
  }

  @media (min-width: 40rem) {
    .hero {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-l);
      padding-top: var(--space-2xl);
    }
    .hero__avatar {
      width: 120px;
      height: 120px;
    }
  }
</style>
